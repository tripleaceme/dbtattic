{
  "name": "dbtattic",
  "displayName": "dbtattic",
  "description": "Browse and query your dbt artifact history without leaving the editor.",
  "version": "0.1.2",
  "publisher": "tripleaceme",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#222835",
    "theme": "dark"
  },
  "keywords": [
    "dbt",
    "duckdb",
    "analytics engineering",
    "data",
    "lineage"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "dbtattic",
      "properties": {
        "dbtattic.cliPath": {
          "type": "string",
          "default": "dbtattic",
          "description": "Path to the dbtattic executable. Supports ${workspaceFolder} and ~, so a project virtualenv can be referenced as ${workspaceFolder}/.venv/bin/dbtattic."
        },
        "dbtattic.projectDir": {
          "type": "string",
          "default": "",
          "description": "dbt project root. Empty means auto-discover by searching for dbt_project.yml. Supports ${workspaceFolder} and ~."
        },
        "dbtattic.historyLimit": {
          "type": "number",
          "default": 25,
          "description": "How many invocations to list in the tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbtattic",
          "title": "dbtattic",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dbtattic": [
        {
          "id": "dbtattic.invocations",
          "name": "Invocations"
        },
        {
          "id": "dbtattic.insights",
          "name": "Insights"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbtattic.invocations",
        "contents": "No dbt project found here.\n\ndbtattic looks for `dbt_project.yml` in this folder and its parents. If your project lives somewhere else, point at it:\n\n[Select dbt Project Folder](command:dbtattic.selectProject)\n\nYou can also open the project as your workspace folder instead.",
        "when": "dbtattic.status == 'no-project'"
      },
      {
        "view": "dbtattic.invocations",
        "contents": "The dbtattic command line tool was not found.\n\nInstall it, then reload:\n\n```\npip install dbtattic\n```\n\nIf it lives in a project virtualenv, set the path to it (`${workspaceFolder}` is supported):\n\n[Open Settings](command:dbtattic.openSettings)",
        "when": "dbtattic.status == 'no-cli'"
      },
      {
        "view": "dbtattic.invocations",
        "contents": "Nothing captured yet.\n\ndbt overwrites `target/` on every invocation. Capture what is there now, or run dbt through dbtattic so it is kept automatically.\n\n[Capture Artifacts Now](command:dbtattic.capture)",
        "when": "dbtattic.status == 'no-store' || dbtattic.status == 'ready'"
      },
      {
        "view": "dbtattic.invocations",
        "contents": "The archive was written by an older dbtattic.\n\nThe archived JSON is the source of truth, so rebuilding loses nothing.\n\n[Rebuild Store](command:dbtattic.rebuild)",
        "when": "dbtattic.status == 'stale-store'"
      }
    ],
    "commands": [
      {
        "command": "dbtattic.refresh",
        "title": "Refresh",
        "category": "dbtattic",
        "icon": "$(refresh)"
      },
      {
        "command": "dbtattic.capture",
        "title": "Capture Artifacts Now",
        "category": "dbtattic",
        "icon": "$(save)"
      },
      {
        "command": "dbtattic.rebuild",
        "title": "Rebuild Store from Archive",
        "category": "dbtattic"
      },
      {
        "command": "dbtattic.query",
        "title": "New Query",
        "category": "dbtattic",
        "icon": "$(search)"
      },
      {
        "command": "dbtattic.copyStatePath",
        "title": "Copy --state Path (Last Success)",
        "category": "dbtattic"
      },
      {
        "command": "dbtattic.openSettings",
        "title": "Open Settings",
        "category": "dbtattic"
      },
      {
        "command": "dbtattic.selectProject",
        "title": "Select dbt Project Folder...",
        "category": "dbtattic",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbtattic.query",
          "when": "view == dbtattic.invocations",
          "group": "navigation@1"
        },
        {
          "command": "dbtattic.capture",
          "when": "view == dbtattic.invocations",
          "group": "navigation@2"
        },
        {
          "command": "dbtattic.refresh",
          "when": "view == dbtattic.invocations",
          "group": "navigation@3"
        },
        {
          "command": "dbtattic.selectProject",
          "when": "view == dbtattic.invocations",
          "group": "navigation@0"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
