{
  "name": "dbtattic",
  "displayName": "dbtattic",
  "description": "Browse and query your dbt artifact history without leaving the editor.",
  "version": "0.1.1",
  "publisher": "tripleaceme",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#222835",
    "theme": "dark"
  },
  "keywords": [
    "dbt",
    "duckdb",
    "analytics engineering",
    "data",
    "lineage"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "dbtattic",
      "properties": {
        "dbtattic.cliPath": {
          "type": "string",
          "default": "dbtattic",
          "description": "Path to the dbtattic executable. Supports ${workspaceFolder} and ~, so a project virtualenv can be referenced as ${workspaceFolder}/.venv/bin/dbtattic."
        },
        "dbtattic.projectDir": {
          "type": "string",
          "default": "",
          "description": "dbt project root. Empty means auto-discover by searching for dbt_project.yml. Supports ${workspaceFolder} and ~."
        },
        "dbtattic.historyLimit": {
          "type": "number",
          "default": 25,
          "description": "How many invocations to list in the tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbtattic",
          "title": "dbtattic",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dbtattic": [
        {
          "id": "dbtattic.invocations",
          "name": "Invocations"
        },
        {
          "id": "dbtattic.insights",
          "name": "Insights"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbtattic.invocations",
        "contents": "No dbtattic store found yet.\n\nThe store is created the first time artifacts are captured.\n\n[Capture now](command:dbtattic.capture)\n\nIf the CLI is not on your PATH, set `dbtattic.cliPath`.\n\n[Open settings](command:dbtattic.openSettings)"
      }
    ],
    "commands": [
      {
        "command": "dbtattic.refresh",
        "title": "Refresh",
        "category": "dbtattic",
        "icon": "$(refresh)"
      },
      {
        "command": "dbtattic.capture",
        "title": "Capture Artifacts Now",
        "category": "dbtattic",
        "icon": "$(save)"
      },
      {
        "command": "dbtattic.rebuild",
        "title": "Rebuild Store from Archive",
        "category": "dbtattic"
      },
      {
        "command": "dbtattic.query",
        "title": "New Query",
        "category": "dbtattic",
        "icon": "$(search)"
      },
      {
        "command": "dbtattic.copyStatePath",
        "title": "Copy --state Path (Last Success)",
        "category": "dbtattic"
      },
      {
        "command": "dbtattic.openSettings",
        "title": "Open Settings",
        "category": "dbtattic"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbtattic.query",
          "when": "view == dbtattic.invocations",
          "group": "navigation@1"
        },
        {
          "command": "dbtattic.capture",
          "when": "view == dbtattic.invocations",
          "group": "navigation@2"
        },
        {
          "command": "dbtattic.refresh",
          "when": "view == dbtattic.invocations",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
